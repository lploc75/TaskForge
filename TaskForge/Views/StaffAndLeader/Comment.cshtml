﻿@{
    Layout = Context.Session.GetString("Layout"); // Đảm bảo Context là một biến có chứa HttpContext
    ViewData["Title"] = "Task Comments";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Comments</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/staff/comment.css" />
</head>

<body>
    <div class="container mt-5">
        <h2 class="mb-4">Comments for Task</h2>
        <!-- Form to add a new comment -->
        <div class="card p-4 mb-4">
            <form method="post" action="/StaffandLeader/AddComment">
                <!-- Sửa lại tên action cho đúng -->
                <input type="hidden" name="subtaskId" value="@ViewBag.SubtaskId" />
                <div class="form-group">
                    <label for="commentText" class="font-weight-bold">Add your comment:</label>
                    <textarea id="commentText" name="commentText" class="form-control" rows="4" placeholder="Write your comment here..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary mt-2">Submit</button>
            </form>
        </div>

        <h3 class="mt-4">All Comments</h3>
        <!-- Comments table -->
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="thead-light">
                    <tr>
                        <th>Account ID</th>
                        <th>Full Name</th>
                        <th>Comment</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Comments != null && ViewBag.Comments.Count > 0)
                    {
                        @foreach (var comment in ViewBag.Comments)
                        {
                            <tr>
                                <td>@((comment.Subtask?.SubtaskAssignments as IEnumerable<TaskForge.Models.SubtaskAssignment>)?.FirstOrDefault()?.AssignedToNavigation?.AccountId ?? "N/A")</td>
                                <td>@((comment.Subtask?.SubtaskAssignments as IEnumerable<TaskForge.Models.SubtaskAssignment>)?.FirstOrDefault()?.AssignedToNavigation?.Fullname ?? "N/A")</td>
                                <td>@comment.Content</td>
                                <td>
                                    <form method="post" action="/StaffandLeader/DeleteComment" class="d-inline">
                                        <input type="hidden" name="commentId" value="@comment.CommentId" />
                                        <input type="hidden" name="subtaskId" value="@ViewBag.SubtaskId" />
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No comments available for this task.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>