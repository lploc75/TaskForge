@{
    ViewData["Title"] = "Task";
    var layout = Context.Session.GetString("Layout"); // Đảm bảo Context là một biến có chứa HttpContext
    Layout = string.IsNullOrEmpty(layout) ? "_DefaultLayout" : layout;

    var subtasks = ViewBag.Subtasks as List<TaskForge.Models.Subtask>;
    var personalTasks = ViewBag.PersonalTasks as List<TaskForge.Models.PersonalTask>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Cards</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/staff/task.css" />
</head>

<body>
    <div class="sidebar-placeholder"></div>
    <!-- Main Content -->
    <div class="main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" id="successMessage">
                @TempData["SuccessMessage"]
            </div>
        }
        <!-- Create Personal Task Button -->
        <div class="create-task-button">
            <button onclick="openCreatePersonalTask();">
                <i class="fas fa-plus"></i> Create Personal Task
            </button>
        </div>
        <p class="filtered-tasks-message">
            Completed task displayed on this page is limited to 10 tasks. To view more, please click the "Filter" button.
        </p>
        <div class="FilteredTasks">
            <form method="get" action="/StaffAndLeader/TaskFilter">
                <button type="submit" class="btn btn-primary">Filter Tasks</button>
            </form>
            <form method="get" action="/StaffAndLeader/PersonalTaskFilter">
                <button type="submit" class="btn btn-primary">Filter Personal Tasks</button>
            </form>
        </div>

        <!-- In Progress Tasks Section -->
        <div class="task-container">
            <div class="task-header" onclick="toggleSection('inProgressTaskList', this)">
                <h2>In Progress Tasks (@subtasks.Where(s => s.Status == "In Progress").Count())</h2>
                <span class="arrow-icon">&#9652;</span>
            </div>
            <div class="task-list" id="inProgressTaskList" style="display: block;">
                @foreach (var subtask in subtasks.Where(s => s.Status == "In Progress"))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', '@subtask.SubtaskId','@subtask.AssignmentDate',
                    '@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
                    '@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description', '@subtask.TaskId',
                    '@subtask.TeamId')">
                        <div class="task-info">
                            <span class="task-title">@subtask.SubtaskName</span>
                            <span class="task-status">(@subtask.Status)</span>
                        </div>
                        <div class="button-container">
                            <!-- Form để Submit Task -->
                            <form method="post" action="/StaffAndLeader/UpdateSubtaskStatus" onsubmit="return confirmSubmitTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <input type="hidden" name="status" value="Pending" />
                                <button type="submit" class="button">Submit Task</button>
                            </form>
                            <!-- Form để Upload File -->
                            <form method="get" action="/StaffAndLeader/UploadFile">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <button type="submit" class="button">Upload File</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Personal Tasks Section -->
        <div class="task-container">
            <div class="task-header" onclick="toggleSection('personalTaskList', this)">
                <h2>Personal Tasks (@personalTasks.Count())</h2>
                <span class="arrow-icon">&#9662;</span>
            </div>
            <div class="task-list" id="personalTaskList" style="display: none;">
                @foreach (var personalTask in personalTasks)
                {
                    <div class="task-item"
                         onclick="checkIfPTaskSubmit(event, '@personalTask.PtaskName', '@personalTask.AssignmentDate',
                 '@personalTask.Deadline', '@personalTask.Priority', '@personalTask.Status', '@personalTask.Description')">
                        <div class="task-info">
                            <span class="task-title">@personalTask.PtaskName</span>
                        <span class="task-status">(@personalTask.Status)</span>
                        </div>
                        <div class="button-container">
                            <button class="button" onclick="openUpdatePersonalTaskModal('@personalTask.PtaskId', 
                            '@personalTask.PtaskName', '@personalTask.AssignmentDate', '@personalTask.Deadline', 
                            '@personalTask.Priority', '@personalTask.Description');">Update</button>
                            <form method="post" action="/StaffAndLeader/UpdatePersonalTaskStatus" onsubmit="return confirmUnsubmitTask()">
                                <input type="hidden" name="PtaskId" value="@personalTask.PtaskId" />
                                <input type="hidden" name="status" value="@personalTask.Status" />
                                <button type="submit" class="button">Change status</button>
                            </form>
                            <form method="post" action="/StaffAndLeader/DeletePersonalTask" onsubmit="return confirmDeletePersonalTask()">
                                <input type="hidden" name="PtaskId" value="@personalTask.PtaskId" />
                                <button type="submit" class="button">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Not Started Tasks Section -->
        <div class="task-container">
            <div class="task-header" onclick="toggleSection('notStartedTaskList', this)">
                <h2>Not Started Tasks (@subtasks.Where(s => s.Status == "Not Start").Count())</h2>
                <span class="arrow-icon">&#9662;</span>
            </div>
            <div class="task-list" id="notStartedTaskList" style="display: none;">
                @foreach (var subtask in subtasks.Where(s => s.Status == "Not Start"))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', '@subtask.SubtaskId','@subtask.AssignmentDate',
                    '@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
                    '@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description', '@subtask.TaskId',
                    '@subtask.TeamId')">
                        <div class="task-info">
                            <span class="task-title">@subtask.SubtaskName</span>
                            <span class="task-status">(@subtask.Status)</span>
                        </div>
                        <div class="button-container">
                            <form method="post" action="/StaffAndLeader/UpdateSubtaskStatus" onsubmit="return confirmAcceptTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <input type="hidden" name="status" value="In Progress" />
                                <button type="submit" class="button">Accept Task</button>
                            </form>
                            <form method="post" action="/StaffAndLeader/RejectSubtask" onsubmit="return confirmRejectTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <button type="submit" class="button reject-button">Reject Task</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Pending Tasks Section -->
        <div class="task-container">
            <div class="task-header" onclick="toggleSection('pendingTaskList', this)">
                <h2>Pending Tasks (@subtasks.Where(s => s.Status == "Pending").Count())</h2>
                <span class="arrow-icon">&#9662;</span>
            </div>
            <div class="task-list" id="pendingTaskList" style="display: none;">
                @foreach (var subtask in subtasks.Where(s => s.Status == "Pending"))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', '@subtask.SubtaskId','@subtask.AssignmentDate',
                    '@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
                    '@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description', '@subtask.TaskId',
                    '@subtask.TeamId')">
                        <div class="task-info">
                            <span class="task-title">@subtask.SubtaskName</span>
                            <span class="task-status">(@subtask.Status)</span>
                        </div>
                        <div class="button-container">
                            <form method="get" action="/StaffAndLeader/Comment">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <button type="submit" class="button">Comment</button>
                            </form>
                            <form method="post" action="/StaffAndLeader/UpdateSubtaskStatus" onsubmit="return confirmUnsubmitTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <input type="hidden" name="status" value="In Progress" />
                                <button type="submit" class="button">Unsubmit</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- View Task History Section -->
        <div class="task-container">
            <div class="task-header" onclick="toggleSection('completedTaskList', this)">
                <h2>View Task History (@subtasks.Where(s => s.Status == "Completed").Count())</h2>
                <span class="arrow-icon">&#9662;</span>
            </div>
            <div class="task-list" id="completedTaskList" style="display: none;">
                @foreach (var subtask in subtasks.Where(s => s.Status == "Completed").Take(10))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', '@subtask.SubtaskId','@subtask.AssignmentDate',
                    '@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
                    '@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description', '@subtask.TaskId',
                    '@subtask.TeamId')">
                        <span class="task-title">@subtask.SubtaskName</span>
                        <span class="task-status">@subtask.Status</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Modal for Subtask Details -->
    <div class="modal" id="taskModal">
        <div class="modal-content">
            <button class="close-button" onclick="closeModal('taskModal')">&times;</button>
            <h3 id="modalTitle">Task Details</h3>
            <p id="modalSubtaskId">Subtask ID: </p>
            <p id="modalTaskId">Task ID: </p>
            <p id="modalTeamId">Team ID: </p>
            <p id="modalAssignedDate">Assigned Date: </p>
            <p id="modalDueDate">Deadline: </p>
            <p id="modalSubmissionDate">Submission Date: </p>
            <p id="modalReward">Reward: </p>
            <div id="modalContent">
                <p>Priority: <span id="modalPriority"></span></p>
                <p>Difficulty: <span id="modalDifficulty"></span></p>
                <p>Status: <span id="modalStatus"></span></p>
                <p>Description: <span id="modalDescription"></span></p>
            </div>
        </div>
    </div>

    <!-- Modal for Personal Task Details -->
    <div class="modal" id="personalTaskModal">
        <div class="modal-content">
            <button class="close-button" onclick="closeModal('personalTaskModal')">&times;</button>
            <h3 id="personalTaskTitle">Personal Task Details</h3>
            <p id="personalTaskAssignedDate">Assigned Date: </p>
            <p id="personalTaskDueDate">Deadline: </p>
            <p id="personalTaskContent">Task description and details go here.</p>
        </div>
    </div>

    <!-- Modal for Creating Personal Task -->
    <div class="modal" id="createPersonalTaskModal">
        <div class="modal-content">
            <button class="close-button" onclick="closeModal('createPersonalTaskModal')">&times;</button>
            <h3>Create New Personal Task</h3>

            <form id="createPersonalTaskForm" method="post" action="/StaffAndLeader/CreatePersonalTask" onsubmit="return confirmCreateTask()">
                <div class="form-group">
                    <label for="taskTitle">Task Title</label>
                    <input type="text" id="taskTitle" name="PtaskName" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="assignedDate">Assignment Date</label>
                    <input type="datetime-local" id="assignedDate" name="assignedDate" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="deadline">Deadline</label>
                    <input type="datetime-local" id="deadline" name="deadline" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="priority">Priority</label>
                    <select id="priority" name="priority" class="form-control" required>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="3">4 </option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" class="form-control" rows="3" required></textarea>
                </div>

                <div class="button-container">
                    <button type="submit" class="button">Create Task</button>
                    <button type="button" class="button" onclick="closeModal('createPersonalTaskModal')">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal for Updating Personal Task -->
    <div class="modal" id="updatePersonalTaskModal">
        <div class="modal-content">
            <button class="close-button" onclick="closeModal('updatePersonalTaskModal')">&times;</button>
            <h3>Update Personal Task</h3>

            <form id="updatePersonalTaskForm" method="post" action="/StaffAndLeader/UpdatePersonalTask" onsubmit="return confirmUpdateTask()">
                <input type="hidden" id="PtaskId" name="PtaskId" />

                <div class="form-group">
                    <label for="taskTitle">Task Title</label>
                    <input type="text" id="updateTaskTitle" name="PtaskName" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="assignedDate">Assignment Date</label>
                    <input type="datetime-local" id="updateAssignedDate" name="assignedDate" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="deadline">Deadline</label>
                    <input type="datetime-local" id="updateDeadline" name="deadline" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="priority">Priority</label>
                    <select id="updatePriority" name="priority" class="form-control" required>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="updateDescription" name="description" class="form-control" rows="3" required></textarea>
                </div>

                <div class="button-container">
                    <button type="submit" class="button">Update Task</button>
                    <button type="button" class="button" onclick="closeModal('updatePersonalTaskModal')">Cancel</button>
                </div>
            </form>
        </div>
    </div>

  <script src="~/js/staff/task.js"></script>
</body>
</html>
