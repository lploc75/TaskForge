@model TaskForge.Models.Employee

@{
    var layout = Context.Session.GetString("Layout"); // Đảm bảo Context là một biến có chứa HttpContext
    Layout = string.IsNullOrEmpty(layout) ? "_DefaultLayout" : layout;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Cards</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/staff/index.css" />
</head>
<body>
    <!-- Profile Container -->
    <div class="profile-container">
        <div class="profile-left">
            <div class="profile-image">
                <img src="https://via.placeholder.com/150" alt="Avatar">
            </div>
            <div class="basic-info">
                <h2>@(Model?.Fullname ?? "N/A")</h2>
                <p>@(Model?.Role ?? "N/A") - Mã @(Model?.AccountId ?? "N/A")</p>
                <p>@(Model?.Dept?.DeptName ?? "N/A")</p>
                <span class="status">@(Model?.Status ?? "N/A")</span>
            </div>
        </div>
        <div class="profile-right">
            <!-- Phone number from Account if available, else use "N/A" -->
            <div class="contact-info">
                <i class="fas fa-phone"></i>
                <span>@(Model?.Account?.PhoneNumber ?? "N/A")</span>
            </div>
            <!-- Email from Account model -->
            <div class="contact-info">
                <i class="fas fa-envelope"></i>
                <span>@(Model?.Account?.Email ?? "N/A")</span>
            </div>
            <!-- Additional Information (if any) -->
            <div class="contact-info">
                <i class="fas fa-id-badge"></i>
                <span>Ngày bắt đầu: @(Model?.StartDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
            </div>
            <div class="contact-info">
                <i class="fas fa-id-badge"></i>
                <span>Ngày kết thúc: @(Model?.EndDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
            </div>
        </div>
    </div>

    <!-- Bottom Section -->
    <div class="bottom-section">
        <!-- Task Status Section -->
        <div class="chart-container">
            <h3>Task Status</h3>
            <div>
                <canvas id="donutChart" width="200" height="200"></canvas>
            </div>

            <!-- Task Summary Section -->
            <div class="task-summary">
                <h4>Hiệu quả công việc</h4>
                <p>Tổng số công việc của bạn: @ViewData["AssignedTaskCount"] việc</p>
                <div class="progress-item">
                    <span>HT trước hạn</span>
                    <div class="progress-bar">
                        <div class="progress progress-before"></div>
                    </div>
                    <span>@ViewData["BeforeDeadlinePercent"]%</span>
                </div>
                <div class="progress-item">
                    <span>H. thành đúng hạn</span>
                    <div class="progress-bar">
                        <div class="progress progress-on"></div>
                    </div>
                    <span>@ViewData["OnDeadlinePercent"]%</span>
                </div>
                <div class="progress-item">
                    <span>H. thành trễ hạn</span>
                    <div class="progress-bar">
                        <div class="progress progress-after"></div>
                    </div>
                    <span>@ViewData["AfterDeadlinePercent"]%</span>
                </div>
            </div>

        </div>

        <!-- Evaluation Box -->
        <div class="evaluation-box">
            <h3>Team Leader's Evaluation</h3>
            <canvas id="radarChart" width="200" height="200"></canvas>
        </div>
    </div>

    <!-- Cards Container -->
    <div class="cards-container">
        <div class="card blue">
            <h2>@ViewData["SimpleTasks"] <span>(@((Convert.ToDouble(ViewData["SimpleTasks"]) * 100.0 / Convert.ToDouble(ViewData["AssignedTaskCount"])).ToString("F1"))%)</span></h2>
            <p>Simple Tasks</p>
            <div class="chart-placeholder"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="card lightblue">
            <h2>@ViewData["ModerateTasks"] <span>(@((Convert.ToDouble(ViewData["ModerateTasks"]) * 100.0 / Convert.ToDouble(ViewData["AssignedTaskCount"])).ToString("F1"))%)</span></h2>
            <p>Moderate Tasks</p>
            <div class="chart-placeholder"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="card yellow">
            <h2>@ViewData["ComplexTasks"] <span>(@((Convert.ToDouble(ViewData["ComplexTasks"]) * 100.0 / Convert.ToDouble(ViewData["AssignedTaskCount"])).ToString("F1"))%)</span></h2>
            <p>Complex Tasks</p>
            <div class="chart-placeholder"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="card red">
            <h2>@ViewData["ExtremelyComplexTasks"] <span>(@((Convert.ToDouble(ViewData["ExtremelyComplexTasks"]) * 100.0 / Convert.ToDouble(ViewData["AssignedTaskCount"])).ToString("F1"))%)</span></h2>
            <p>Extremely Complex Tasks</p>
            <div class="chart-placeholder"><i class="fas fa-chart-line"></i></div>
        </div>
    </div>


    <!-- Kết nối tệp JavaScript -->
    <script>
        const totalKPI = parseFloat('@ViewData["TotalKPI"]' || 0);
        const totalTimeliness = parseFloat('@ViewData["TotalTimeliness"]' || 0);
        const totalTeamwork = parseFloat('@ViewData["TotalTeamwork"]' || 0);
    </script>
    <script src="/js/staff/index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy giá trị phần trăm từ ViewData và chuyển thành số
            const beforeDeadlinePercent = parseFloat('@(ViewData["BeforeDeadlinePercent"] ?? 0)').toFixed(1);
            const onDeadlinePercent = parseFloat('@(ViewData["OnDeadlinePercent"] ?? 0)').toFixed(1);
            const afterDeadlinePercent = parseFloat('@(ViewData["AfterDeadlinePercent"] ?? 0)').toFixed(1);

            // Lấy danh sách tất cả các .progress-item
            const progressItems = document.querySelectorAll(".task-summary .progress");

            // Đặt chiều rộng cho từng thanh tiến độ nếu tồn tại
            if (progressItems[0]) progressItems[0].style.width = beforeDeadlinePercent + "%";
            if (progressItems[1]) progressItems[1].style.width = onDeadlinePercent + "%";
            if (progressItems[2]) progressItems[2].style.width = afterDeadlinePercent + "%";

            // Cập nhật văn bản phần trăm với giá trị đã làm tròn
            const progressTexts = document.querySelectorAll(".task-summary .progress-item span:last-child");
            if (progressTexts[0]) progressTexts[0].textContent = beforeDeadlinePercent + "%";
            if (progressTexts[1]) progressTexts[1].textContent = onDeadlinePercent + "%";
            if (progressTexts[2]) progressTexts[2].textContent = afterDeadlinePercent + "%";
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy giá trị phần trăm từ ViewData và chuyển thành số
            const beforeDeadlinePercent = parseFloat('@(ViewData["BeforeDeadlinePercent"] ?? 0)').toFixed(1);
            const onDeadlinePercent = parseFloat('@(ViewData["OnDeadlinePercent"] ?? 0)').toFixed(1);
            const afterDeadlinePercent = parseFloat('@(ViewData["AfterDeadlinePercent"] ?? 0)').toFixed(1);

            // Cập nhật chiều rộng cho các thanh tiến độ
            const beforeBar = document.querySelector(".progress-before");
            const onBar = document.querySelector(".progress-on");
            const afterBar = document.querySelector(".progress-after");

            if (beforeBar) beforeBar.style.width = beforeDeadlinePercent + "%";
            if (onBar) onBar.style.width = onDeadlinePercent + "%";
            if (afterBar) afterBar.style.width = afterDeadlinePercent + "%";
        });
        document.addEventListener("DOMContentLoaded", function () {
            const completedCount = parseInt('@ViewData["CompletedCount"]') || 0;
            const canceledCount = parseInt('@ViewData["CanceledCount"]') || 0;
            const incompleteCount = parseInt('@ViewData["IncompleteCount"]') || 0;

            const ctx = document.getElementById('donutChart').getContext('2d');
            const donutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Completed', 'Incomplete', 'Canceled'],
                    datasets: [{
                        data: [completedCount, incompleteCount, canceledCount],
                        backgroundColor: ['#007bff', '#ffe0b2', '#b3e5fc'],
                        borderWidth: 1
                    }]
                },
                options: {
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom'
                        },
                        datalabels: {
                            color: '#000000',
                            formatter: (value, context) => {
                                const total = context.chart.data.datasets[0].data.reduce((acc, curr) => acc + curr, 0);
                                const percentage = ((value / total) * 100).toFixed(1) + '%';
                                return percentage;
                            },
                            font: {
                                weight: 'bold'
                            }
                        }
                    },
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%'
                },
                plugins: [ChartDataLabels] // Thêm plugin hiển thị dữ liệu
            });
        });

    </script>


</body>
</html>