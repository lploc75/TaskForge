@{
    Layout = Context.Session.GetString("Layout"); // Đảm bảo Context là một biến có chứa HttpContext
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bảng Kanban Quản lý dự án</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        /* General Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f7fa;
            color: #333;
            padding: 20px;
        }

        /* Kanban Board Styling */
        .kanban-board {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .header h1 {
                font-size: 24px;
                color: #333;
            }

        .search-input {
            width: 300px;
            padding: 12px;
            border: 1px solid #007bff;
            border-radius: 5px;
        }

        /* Kanban Sections */
        .kanban-section {
            margin-bottom: 40px;
            padding: 15px;
            background-color: #ffffffc1;
            border-radius: 10px;
        }

            .kanban-section h2 {
                font-size: 20px;
                color: #333;
                margin-bottom: 15px;
            }

        .kanban-row {
            display: flex;
            justify-content: left;
            gap: 50px;
        }

        /* Kanban Cards */
        .task-card {
            background-color: #fff;
            border-radius: 10px;
            padding: 20px;
            width: 30%;
            box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .task-card:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            }

            .task-card h3 {
                font-size: 18px;
                color: #007bff;
                margin-bottom: 10px;
            }

            .task-card p {
                font-size: 14px;
                color: #666;
                margin-bottom: 10px;
            }

        .progress-bar {
            width: 100%;
            background-color: #e0e0e0;
            border-radius: 5px;
            height: 8px;
            margin-bottom: 10px;
        }

        .progress {
            height: 100%;
            border-radius: 5px;
        }

        .progress-completed {
            background-color: #4CAF50;
        }

        .progress-ongoing {
            background-color: #007bff;
        }

        .progress-cancelled {
            background-color: #FF5722;
        }

        /* Button Styles */
        .btn {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
            margin-top: 10px;
            font-size: 14px;
        }

        .btn-edit {
            background-color: #17a2b8;
            color: white;
        }

            .btn-edit:hover {
                background-color: #138496;
            }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background-color: #c82333;
            }

        .create-project-btn {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            position: fixed;
            bottom: 20px;
            right: 20px;
            transition: background-color 0.3s;
        }

            .create-project-btn:hover {
                background-color: #388e3c;
            }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000; /* Đảm bảo modal luôn nằm trên các thành phần khác */
        }

    </style>
</head>
<body>
    <div class="kanban-board">
        <div class="header">
            <h1>Bảng Kanban - Quản lý dự án</h1>
            <div class="actions">
                <input type="text" class="search-input" placeholder="Tìm kiếm...">
            </div>
        </div>

        <!-- Section 1: Đang Tiến Hành -->
        <div class="kanban-section">
            @try
            {
                @if (ViewBag.OngoingProjects != null && ViewBag.OngoingProjects.Count > 0)
                {
                    @foreach (var project in ViewBag.OngoingProjects)
                    {
                        <div class="task-card">
                            <h3>
                                <a href="javascript:void(0)"
                                   onclick="openProjectDetails('@project.ProjectId', '@project.ProjectName', '@project.Description', '@project.Deadline?.ToString("yyyy-MM-dd")', '@project.Status')">
                                    @project.ProjectName
                                </a>
                            </h3>
                            <p>Mô tả: @project.Description</p>
                            <p>Hạn chót: @project.Deadline?.ToString("yyyy-MM-dd")</p>
                            <div class="progress-bar">
                                <div class="progress progress-ongoing" style="width: 60%;"></div>
                            </div>
                            <span>Trạng thái: @project.Status</span>
                        </div>
                    }
                }
                else
                {
                    <p>Không có dự án nào đang tiến hành.</p>
                }
            }
            catch (Exception ex)
            {
                <p>Có lỗi xảy ra khi tải dữ liệu: @ex.Message</p>
            }
        </div>

        <!-- Section 2: Đã Hoàn Thành -->
        <div class="kanban-section">
            <h2>Đã hoàn thành</h2>
            <div class="kanban-row">
                @try
                {
                    @if (ViewBag.CompletedProjects != null && ViewBag.CompletedProjects.Count > 0)
                    {
                        @foreach (var project in ViewBag.CompletedProjects)
                        {
                            <div class="task-card">
                                <h3><a href="@Url.Action("ProjectDetails", "Manager", new { id = project.ProjectId })">@project.ProjectName</a></h3>
                                <p>Mô tả: @project.Description</p>
                                <p>Hạn chót: @project.Deadline?.ToString("yyyy-MM-dd")</p>
                                <div class="progress-bar">
                                    <div class="progress progress-completed" style="width: 100%;"></div>
                                </div>
                                <span>Trạng thái: @project.Status</span>
                                <button class="btn btn-edit" onclick="openEditModal('@project.ProjectId')">Sửa</button>
                                <button class="btn btn-delete" onclick="deleteProject('@project.ProjectId')">Xóa</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Không có dự án nào đã hoàn thành.</p>
                    }
                }
                catch (Exception ex)
                {
                    <p>Có lỗi xảy ra khi tải dữ liệu: @ex.Message</p>
                }
            </div>
        </div>

        <!-- Section 3: Đã Hủy -->
        <div class="kanban-section">
            <h2>Đã hủy</h2>
            <div class="kanban-row">
                @try
                {
                    @if (ViewBag.CancelledProjects != null && ViewBag.CancelledProjects.Count > 0)
                    {
                        @foreach (var project in ViewBag.CancelledProjects)
                        {
                            <div class="task-card">
                                <h3><a href="@Url.Action("ProjectDetails", "Manager", new { id = project.ProjectId })">@project.ProjectName</a></h3>
                                <p>Mô tả: @project.Description</p>
                                <p>Hạn chót: @project.Deadline?.ToString("yyyy-MM-dd")</p>
                                <div class="progress-bar">
                                    <div class="progress progress-cancelled" style="width: 20%;"></div>
                                </div>
                                <span>Trạng thái: @project.Status</span>
                                <button class="btn btn-edit" onclick="openEditModal('@project.ProjectId')">Sửa</button>
                                <button class="btn btn-delete" onclick="deleteProject('@project.ProjectId')">Xóa</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Không có dự án nào đã hủy.</p>
                    }
                }
                catch (Exception ex)
                {
                    <p>Có lỗi xảy ra khi tải dữ liệu: @ex.Message</p>
                }
            </div>
        </div>
    </div>

    <!-- Modal chi tiết dự án -->
    <div id="modal" class="modal" style="display: none;">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2>Chi tiết dự án</h2>
            <p><strong>Tên dự án:</strong> <span id="modal-project-name"></span></p>
            <p><strong>Mô tả:</strong> <span id="modal-project-description"></span></p>
            <p><strong>Hạn chót:</strong> <span id="modal-project-deadline"></span></p>
            <p><strong>Trạng thái:</strong> <span id="modal-project-status"></span></p>
        </div>
    </div>

    <script>
        function openProjectDetails(projectId, projectName, projectDescription, projectDeadline, projectStatus) {
            // Hiển thị modal
            document.getElementById("modal").style.display = "flex";

            // Gán dữ liệu vào modal
            document.getElementById("modal-project-name").innerText = projectName;
            document.getElementById("modal-project-description").innerText = projectDescription;
            document.getElementById("modal-project-deadline").innerText = projectDeadline;
            document.getElementById("modal-project-status").innerText = projectStatus;
        }

        function closeModal() {
            document.getElementById("modal").style.display = "none";
        }
    </script>

   
</body>
</html>
