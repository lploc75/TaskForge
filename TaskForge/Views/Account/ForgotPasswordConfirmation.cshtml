@{
    ViewData["Title"] = "Password Reset Confirmation";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Confirmation</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #E0F7FA;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            display: flex;
            width: 800px;
            height: 400px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            overflow: hidden;
        }

        .left-panel {
            background-color: #2c6eb9;
            color: white;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .right-panel {
            background-color: #FFFFFF;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            text-align: center;
        }

        .owl-image {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 60px;
        }

        .right-panel h2 {
            font-size: 20px;
            color: #0277BD;
            margin-bottom: 20px;
        }

        .confirmation-message {
            font-size: 16px;
            color: #333;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .back-link {
            color: #0277BD;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
        }

            .back-link:hover {
                color: #1a62b4;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-panel">
            <h1>Password Reset</h1>
            <p>Check your email for further instructions.</p>
        </div>
        <div class="right-panel">
            <img src="~/imgs/owlreveal.png" alt="Owl Image" class="owl-image">
            <h2>Confirmation</h2>
            <p class="confirmation-message">
                An email with password reset instructions has been sent to your email address. Please check your inbox and follow the instructions to reset your password.
            </p>
            <p><a href="~/Account/Login" class="back-link">Back to Login</a></p>
        </div>
    </div>
</body>
</html>
