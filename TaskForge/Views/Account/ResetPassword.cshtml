@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #E0F7FA;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            display: flex;
            width: 800px;
            height: 400px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            overflow: hidden;
        }

        .left-panel {
            background-color: #2c6eb9;
            color: white;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .right-panel {
            background-color: #FFFFFF;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            text-align: center;
        }

        .owl-image {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 60px;
        }

        .right-panel h2 {
            font-size: 20px;
            color: #0277BD;
            margin-bottom: 20px;
        }

        .form-group {
            width: 100%;
            margin-bottom: 20px;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            color: #333;
            margin-bottom: 5px;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #B0BEC5;
            border-radius: 5px;
            outline: none;
            font-size: 14px;
        }

        .reset-btn {
            background-color: #1a62b4;
            color: #fff;
            padding: 10px;
            border: none;
            width: 100%;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .reset-btn:hover {
            background-color: #0277BD;
        }

        .back-link {
            color: #0277BD;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
            margin-top: 15px;
            display: inline-block;
        }

        .back-link:hover {
            color: #1a62b4;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-panel">
            <h1>Reset Your Password</h1>
            <p>Please enter your new password below.</p>
        </div>
        <div class="right-panel">
            <img src="~/imgs/owlreveal.png" alt="Owl Image" class="owl-image">
            <h2>Enter New Password</h2>
            <form action="~/Account/ResetPassword" method="post">
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input type="password" id="newPassword" name="newPassword" required>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required>
                </div>
                <button type="submit" class="reset-btn">Reset Password</button>
            </form>
            <p><a href="~/Account/Login" class="back-link">Back to Login</a></p>
        </div>
    </div>
</body>
</html>
