@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <style>
        /* Reuse the styling from the login page */
        body {
            font-family: Arial, sans-serif;
            background-color: #E0F7FA;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            display: flex;
            width: 800px;
            height: 400px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            overflow: hidden;
        }

        .left-panel {
            background-color: #2c6eb9;
            color: white;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .right-panel {
            background-color: #FFFFFF;
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        .owl-image {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 60px;
        }

        .right-panel h2 {
            font-size: 20px;
            color: #0277BD;
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #333;
            margin-bottom: 5px;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #B0BEC5;
            border-radius: 5px;
            outline: none;
            font-size: 14px;
        }

        .reset-btn {
            background-color: #1a62b4;
            color: #fff;
            padding: 10px;
            border: none;
            width: 100%;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .reset-btn:hover {
                background-color: #0277BD;
            }

        .right-panel p {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
        }

            .right-panel p a {
                color: #0277BD;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-panel">
            <h1>Forgot Password?</h1>
            <p>Enter your email to receive password reset instructions.</p>
        </div>
        <div class="right-panel">
            <img src="~/imgs/owlreveal.png" alt="Owl Image" class="owl-image" id="owl">
            <h2>Password Recovery</h2>
            <form action="#" method="post">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <button type="submit" class="reset-btn">Send Reset Link</button>
            </form>
            <p><a href="~/Account/Login">Back to Login</a></p>
        </div>
    </div>
</body>
</html>
