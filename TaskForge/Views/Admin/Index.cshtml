@model TaskForge.Models.Employee

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout"; // Changed the layout for admin
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Profile</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin.css" /> <!-- Include admin-specific CSS -->
</head>
<style>
    /* General Reset */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        background-color: #f5f7fa;
        color: #333;
        margin: 20px;
    }

    .profile-container {
        display: flex;
        align-items: center;
        background-color: #f0f4ff;
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
        color: #333;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.1);
        max-width: 95%;
    }

    .profile-left {
        display: flex;
        align-items: center;
        margin-right: 20px;
    }

    .profile-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        margin-right: 20px;
        background-color: #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .profile-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .basic-info {
        display: flex;
        flex-direction: column;
    }

        .basic-info h2 {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .basic-info p {
            font-size: 16px;
            margin: 3px 0;
        }

    .status {
        margin-top: 10px;
        padding: 8px 15px;
        background-color: #4CAF50;
        border-radius: 15px;
        color: #fff;
        font-size: 14px;
        text-align: center;
        max-width: fit-content;
    }

    .profile-right {
        flex: 1;
        font-size: 16px;
        color: #333;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .contact-info {
        display: flex;
        align-items: center;
        font-size: 16px;
    }

        .contact-info i {
            color: #007bff;
            margin-right: 10px;
            font-size: 18px;
        }

        .contact-info span {
            color: #333;
            font-size: 16px;
        }

</style>
<body>
    <!-- Profile Container -->
    <div class="profile-container">
        <div class="profile-left">
            <div class="profile-image">
                <img src="https://via.placeholder.com/150" alt="Avatar">
            </div>
            <div class="basic-info">
                <h2>@(Model?.Fullname ?? "N/A")</h2>
                <p>@(Model?.Role ?? "Admin") - Mã @(Model?.AccountId ?? "N/A")</p>
                <p>@(Model?.Dept?.DeptName ?? "Admin Department")</p>
                <span class="status">@(Model?.Status ?? "Active")</span>
            </div>
        </div>
        <div class="profile-right">
            <div class="contact-info">
                <i class="fas fa-phone"></i>
                <span>@(Model?.Account?.PhoneNumber ?? "N/A")</span>
            </div>
            <div class="contact-info">
                <i class="fas fa-envelope"></i>
                <span>@(Model?.Account?.Email ?? "N/A")</span>
            </div>
            <div class="contact-info">
                <i class="fas fa-id-badge"></i>
                <span>Ngày bắt đầu: @(Model?.StartDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
            </div>
            <div class="contact-info">
                <i class="fas fa-id-badge"></i>
                <span>Ngày kết thúc: @(Model?.EndDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
            </div>
        </div>
    </div>
</body>
</html>
