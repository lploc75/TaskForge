@* _Sidebar.cshtml *@
@{
    ViewData["Title"] = "Staff Sidebar";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Sidebar</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Tổng quát */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: flex;
            height: 100vh;
            background-color: #f0f0f0;
        }

        /* Sidebar */
        .sidebar {
            width: 80px;
            background: linear-gradient(to top, #d3b5ff, #aa3aeb);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px 0;
        }

        /* Ảnh đại diện */
        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            margin-bottom: 10px;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* Menu icon */
        .menu {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-grow: 1;
            justify-content: space-evenly; /* Phân bổ đều icon theo chiều dọc */
        }

        .menu-icon {
            font-size: 24px;
            color: #fff;
            cursor: pointer;
            transition: color 0.3s ease;
        }

            .menu-icon:hover {
                color: #d3b5ff;
            }
    </style>
</head>
<body>
    @* _Sidebar.cshtml *@
    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Avatar -->
        <div class="avatar">
            <img src="https://via.placeholder.com/50" alt="Avatar">
        </div>

        <div class="menu">
            <div class="menu-icon" title="Home"><i class="fas fa-home"></i></div>
            <div class="menu-icon" title="Task"><i class="fas fa-tasks"></i></div>
            <div class="menu-icon" title="Project"><i class="fas fa-project-diagram"></i></div>
            <div class="menu-icon" title="Notification"><i class="fas fa-bell"></i></div>
            <div class="menu-icon" title="Settings"><i class="fas fa-cog"></i></div>
        </div>
    </div>
</body>
</html>

