@{
    ViewData["Title"] = "Staff Home Page";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Cards</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #2c2f33;
            padding: 20px;
            color: #fff;
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            right: 0;
            background-color: #2c2f33;
            display: flex;
            align-items: center;
            padding: 10px 20px;
            border-radius: 0 0 8px 8px;
            z-index: 1000;
            border-bottom: 2px solid #444;
            width: 100%;
            justify-content: flex-end;
        }

            .navbar .icon-container {
                position: relative;
                margin: 0 10px;
                color: #fff;
            }

                .navbar .icon-container i {
                    font-size: 20px;
                }

                .navbar .icon-container .badge {
                    position: absolute;
                    top: -5px;
                    right: -10px;
                    background-color: red;
                    color: white;
                    border-radius: 50%;
                    padding: 2px 5px;
                    font-size: 12px;
                }

            .navbar .avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                overflow: hidden;
                margin-left: 15px;
            }

                .navbar .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
        /* Profile Information Container */
        .profile-container {
            display: flex;
            align-items: center;
            background-color: #3a3d42;
            border-radius: 12px;
            padding: 20px 100px;
            margin-top: 110px;
            margin-left: 85px;
            color: #fff;
            box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.3);
            max-width: 86.4%;
            justify-content: flex-start;
        }

        .profile-image {
            flex: 0 0 80px; /* Giảm kích thước ảnh đại diện */
            width: 80px;
            height: 80px;
            border-radius: 50%;
            overflow: hidden;
            margin-right: 20px;
        }

            .profile-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .profile-details {
            display: flex;
            flex-direction: column;
            justify-content: center;
            flex: 1;
        }

            .profile-details h2 {
                font-size: 20px; /* Giảm cỡ chữ để căn gọn */
                font-weight: bold;
                margin-bottom: 5px;
            }

            .profile-details p {
                font-size: 14px; /* Giảm cỡ chữ */
                margin: 3px 0;
            }

        .status {
            display: inline-block;
            margin-top: 8px;
            padding: 5px 12px;
            background-color: #4CAF50;
            border-radius: 5px;
            color: #fff;
            font-size: 12px;
        }

        /* Layout for bottom section */
        .bottom-section {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            justify-content: space-between;
            padding: 0 79px; /* Điều chỉnh lề trái và phải */
        }

        /* Left side: Pie chart container */
        .pie-chart-container {
            flex: 1.08; /* Chiếm không gian vừa đủ theo Flexbox */
            background-color: #3a3d42;
            border-radius: 12px;
            padding: 2px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .pie-chart-placeholder {
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: conic-gradient( #a3b18a 0% 35%, /* Xanh lá olive nhạt - Đã hoàn thành */
            #f4d35e 35% 70%, /* Vàng nâu nhạt - Chưa hoàn thành */
            #e07a5f 70% 100% /* Nâu đỏ nhạt - Đã hủy */
            ), radial-gradient(circle, rgba(255,255,255,0.15), transparent); /* Hiệu ứng ánh sáng */
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0px 15px 30px rgba(0, 0, 0, 0.3); /* Bóng mờ nhẹ */
            border: 8px solid #2d2f34; /* Viền tối để làm nổi bật */
            position: relative;
            margin-bottom: 15px;
        }

        /* Chú thích */
        .legend {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            font-size: 16px;
            color: #ececec;
        }

        .legend-color {
            width: 16px;
            height: 16px;
            margin-right: 8px;
            border-radius: 50%;
        }

        .legend-complete {
            background: linear-gradient(135deg, #a3b18a, #7d9774); /* Xanh olive gradient */
        }

        .legend-incomplete {
            background: linear-gradient(135deg, #f4d35e, #e0b54e); /* Vàng nâu nhạt */
        }

        .legend-canceled {
            background: linear-gradient(135deg, #e07a5f, #c7634d); /* Nâu đỏ nhạt */
        }

        /* Right side: Evaluation box */
        .evaluation-box {
            flex: 1;
            background-color: #3a3d42;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .criteria {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            font-size: 16px;
            color: #ececec;
        }

            .criteria .label {
                flex: 1;
            }

            .criteria .bar-container {
                width: 45%; /* Đặt chiều rộng cố định cho thanh để căn đều */
                height: 10px;
                background-color: #555;
                border-radius: 5px;
                margin: 0 15px;
                position: relative;
                overflow: hidden;
                display: flex;
                justify-content: flex-start;
            }

            .criteria .bar {
                height: 100%;
                border-radius: 5px;
            }

            .criteria .bar-quality {
                width: 85%; /* Tùy chỉnh theo phần trăm */
                background-color: #a3b18a;
            }

            .criteria .bar-timeliness {
                width: 90%; /* Tùy chỉnh theo phần trăm */
                background-color: #f4d35e;
            }

            .criteria .bar-communication {
                width: 80%; /* Tùy chỉnh theo phần trăm */
                background-color: #e07a5f;
            }

            .criteria .percentage {
                flex: 1;
                color: #f4d35e;
                font-weight: bold;
                text-align: right;
            }

        .evaluation-box h3 {
            margin-top: -130px;
            margin-bottom: 40px;
        }

        /* Cards Container */
        .cards-container {
            display: flex;
            gap: 20px;
            margin-top: 30px; /* Đẩy xuống dưới thanh navbar */
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Individual Card */
        .card {
            flex: 1 1 200px;
            max-width: 250px;
            padding: 20px;
            border-radius: 12px;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.3); /* Bóng mờ nhẹ để nổi bật ô */
        }

            .card h2 {
                font-size: 24px;
                margin-bottom: 5px;
            }

            .card p {
                font-size: 16px;
            }

            .card .chart-placeholder {
                height: 60px;
                margin-top: 15px;
                opacity: 0.7;
            }

        .blue {
            background-color: #4e73df;
        }

        .lightblue {
            background-color: #36b9cc;
        }

        .yellow {
            background-color: #f6c23e;
        }

        .red {
            background-color: #e74a3b;
        }
    </style>
</head>
<body>
    @Html.Partial("_Sidebar")
    <!-- Profile Information Container -->
    <div class="profile-container">
        <div class="profile-image">
            <img src="https://via.placeholder.com/100" alt="Profile Picture">
        </div>
        <div class="profile-details">
            <h2>Lê Việt Thắng</h2>
            <p>Giám đốc kinh doanh - Mã 00708/HN.291</p>
            <p>Ban Giám đốc</p>
            <span class="status">Đang làm việc</span>
        </div>
    </div>

    <!-- Cards Container -->
    <div class="cards-container">
        <!-- Card 1 -->
        <div class="card blue">
            <h2>14 <span>(12.4%)</span></h2>
            <p>Simple Tasks</p>
            <div class="chart-placeholder">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="card lightblue">
            <h2>45 <span>(65.9%)</span></h2>
            <p>Moderate Tasks</p>
            <div class="chart-placeholder">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="card yellow">
            <h2>12 <span>(10.3%)</span></h2>
            <p>Complex Tasks</p>
            <div class="chart-placeholder">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="card red">
            <h2>2 <span>(5%)</span></h2>
            <p>Extremely Complex Tasks</p>
            <div class="chart-placeholder">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>
    </div>

    <!-- Bottom Section -->
    <div class="bottom-section">
        <!-- Left: Pie Chart Container -->
        <div class="pie-chart-container">
            <h3>Task Status</h3>
            <div class="pie-chart-placeholder"></div>
            <div class="legend">
                <div class="legend-item">
                    <span class="legend-color legend-complete"></span>
                    <span>Completed</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color legend-incomplete"></span>
                    <span>Incomplete</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color legend-canceled"></span>
                    <span>Canceled</span>
                </div>
            </div>
        </div>

        <!-- Right: Evaluation Box -->
        <div class="evaluation-box">
            <h3>Supervisor's Evaluation</h3>
            <div class="criteria">
                <div class="label">Quality</div>
                <div class="bar-container">
                    <div class="bar bar-quality"></div>
                </div>
                <div class="percentage">85% (17/20)</div>
            </div>
            <div class="criteria">
                <div class="label">Timeliness</div>
                <div class="bar-container">
                    <div class="bar bar-timeliness"></div>
                </div>
                <div class="percentage">90% (18/20)</div>
            </div>
            <div class="criteria">
                <div class="label">Communication</div>
                <div class="bar-container">
                    <div class="bar bar-communication"></div>
                </div>
                <div class="percentage">80% (16/20)</div>
            </div>
        </div>
    </div>
</body>

</html>
