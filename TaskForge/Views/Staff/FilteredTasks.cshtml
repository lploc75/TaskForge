@{
    ViewData["Title"] = "Filtered Tasks";
    Layout = "_StaffLayout";
    var subtasks = ViewBag.Subtasks as List<TaskForge.Models.Subtask>;
    var personalTasks = ViewBag.PersonalTasks as List<TaskForge.Models.PersonalTask>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filtered Tasks</title>
    <link href="~/css/staff/FilteredTasks.css" rel="stylesheet" />
</head>
<body>

    <div class="main-content">
        <!-- Filter Form -->
        <form asp-action="FilteredTasks" method="get">
            <div class="form-group">
                <label for="taskType">Task Type</label>
                <select id="taskType" name="taskType" class="form-control" onchange="toggleDifficultyField()">
                    <option value="all">All</option>
                    <option value="personal">Personal Task</option>
                    <option value="subtask">Subtask</option>
                </select>
            </div>

            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control">
                    <option value="">All</option>
                    <option value="Completed">Completed</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Not Start">Not Start</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>

            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control">
                    <option value="">All</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>

            <!-- Difficulty Field -->
            <div class="form-group" id="difficultyField">
                <label for="difficulty">Difficulty</label>
                <select id="difficulty" name="difficulty" class="form-control">
                    <option value="">All</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>

            <div class="form-group">
                <label for="deadline">Deadline</label>
                <input type="date" id="deadline" name="deadline" class="form-control" />
            </div>

            <div class="btn-container">
                <button type="submit" class="btn">Filter</button>
            </div>
        </form>

        <h2>Filtered Tasks</h2>

        <!-- Subtasks Section -->
        @if (subtasks != null && subtasks.Any())
        {
            <h3>Subtasks</h3>
            <table class="task-table">
                <thead>
                    <tr>
                        <th>Subtask ID</th>
                        <th>Subtask Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Difficulty</th>
                        <th>Assignment Date</th>
                        <th>Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subtask in subtasks)
                    {
                        <tr>
                            <td>@subtask.SubtaskId</td>
                            <td>@subtask.SubtaskName</td>
                            <td>@subtask.Description</td>
                            <td>@subtask.Status</td>
                            <td>@subtask.Priority</td>
                            <td>@subtask.Difficulty</td>
                            <td>@subtask.AssignmentDate</td>
                            <td>@subtask.Deadline</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Personal Tasks Section -->
        @if (personalTasks != null && personalTasks.Any())
        {
            <h3>Personal Tasks</h3>
            <table class="task-table">
                <thead>
                    <tr>
                        <th>Task ID</th>
                        <th>Task Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Assignment Date</th>
                        <th>Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var personalTask in personalTasks)
                    {
                        <tr>
                            <td>@personalTask.PtaskId</td>
                            <td>@personalTask.PtaskName</td>
                            <td>@personalTask.Description</td>
                            <td>@personalTask.Status</td>
                            <td>@personalTask.Priority</td>
                            <td>@personalTask.AssignmentDate</td>
                            <td>@personalTask.Deadline</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <script>
        function toggleDifficultyField() {
            var taskType = document.getElementById('taskType').value;
            var difficultyField = document.getElementById('difficultyField');
            if (taskType === 'personal') {
                difficultyField.style.display = 'none';
            } else {
                difficultyField.style.display = 'block';
            }
        }
    </script>

</body>
</html>
