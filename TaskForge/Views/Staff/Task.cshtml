@model List<TaskForge.Models.Subtask>

@{
    ViewData["Title"] = "Task";
    Layout = "_StaffLayout";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Cards</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/staff/task.css" />
</head>

<style>
    .task-header {
        display: flex;
        align-items: center;
        cursor: pointer;
    }

    .arrow-icon {
        margin-left: auto;
        font-size: 3em; /* Tăng kích thước mũi tên */
    }
</style>

<body>
    <div class="sidebar-placeholder"></div>
    <!-- Main Content -->
    <div class="main-content">

        <!-- Create Personal Task Button -->
        <div class="create-task-button">
            <button onclick="createPersonalTask()">
                <i class="fas fa-plus"></i> Create Personal Task
            </button>
        </div>

        <!-- Filter Form -->
        <form asp-action="TaskFilter" method="get">
            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control" onchange="filterTasksByStatus()">
                    <option value="">All</option>
                    <option value="Completed">Completed</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Not Start">Not Start</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>

            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control">
                    <option value="">All</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>

            <div class="form-group">
                <label for="difficulty">Difficulty</label>
                <select id="difficulty" name="difficulty" class="form-control">
                    <option value="">All</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>

            <div class="form-group">
                <label for="deadline">Deadline</label>
                <input type="date" id="deadline" name="deadline" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Filter</button>
        </form>

        <!-- In Progress Tasks Section -->
        <div class="task-container" id="inProgressTaskSection">
            <div class="task-header" onclick="toggleSection('inProgressTaskList', this)">
                <h2>In Progress Tasks (@Model.Where(s => s.Status == "In Progress").Count())</h2>
                <span class="arrow-icon">&#9652;</span> <!-- Mũi tên lên mặc định -->
            </div>
            <div class="task-list" id="inProgressTaskList" style="display: block;">
                @foreach (var subtask in Model.Where(s => s.Status == "In Progress"))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', 'Assigned By','@subtask.AssignmentDate',
'@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
'@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description')">
                        <div class="task-info">
                            <span class="task-title">@subtask.SubtaskName</span>
                            <span class="task-status">(@subtask.Status)</span>
                        </div>
                        <div class="button-container">
                            <!-- Form để Submit Task -->
                            <form method="post" action="/Staff/UpdateStatus" onsubmit="return confirmSubmitTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <input type="hidden" name="status" value="Pending" />
                                <button type="submit" class="button">Submit Task</button>
                            </form>
                            <!-- Form để Upload File -->
                            <form method="get" action="/Staff/UploadFile">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <button type="submit" class="button">Upload File</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Personal Tasks Section -->
        <div class="task-container" id="personalTaskSection">
            <div class="task-header" onclick="toggleSection('personalTaskList', this)">
                <h2>Personal Tasks (@Model.Where(s => s.Status == "Personal Task").Count())</h2>
                <span class="arrow-icon">&#9662;</span> <!-- Mũi tên xuống mặc định -->
            </div>
            <div class="task-list" id="personalTaskList" style="display: none;">
                @foreach (var subtask in Model.Where(s => s.Status == "Personal Task"))
                {
                    <div class="task-item" onclick="openModal('@subtask.SubtaskName', 'Assigned By','@subtask.AssignmentDate',
                    '@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
                    '@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description')">
                        <span class="task-title">@subtask.SubtaskName</span>
                        <span class="task-status">@subtask.Status</span>
                    </div>
                }
            </div>
        </div>

        <!-- Not Started Tasks Section -->
        <div class="task-container" id="notStartedSection">
            <div class="task-header" onclick="toggleSection('notStartedTaskList', this)">
                <h2>Not Started Tasks (@Model.Where(s => s.Status == "Not Start").Count())</h2>
                <span class="arrow-icon">&#9662;</span> <!-- Mũi tên xuống mặc định -->
            </div>
            <div class="task-list" id="notStartedTaskList" style="display: none;">
                @foreach (var subtask in Model.Where(s => s.Status == "Not Start"))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', 'Assigned By','@subtask.AssignmentDate',
'@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
'@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description')">
                        <div class="task-info">
                            <span class="task-title">@subtask.SubtaskName</span>
                            <span class="task-status">(@subtask.Status)</span>
                        </div>
                        <div class="button-container">
                            <!-- Form để Accept Task -->
                            <form method="post" action="/Staff/UpdateStatus" onsubmit="return confirmAcceptTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <input type="hidden" name="status" value="In Progress" />
                                <button type="submit" class="button">Accept Task</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Pending Tasks Section -->
        <div class="task-container" id="pendingTaskSection">
            <div class="task-header" onclick="toggleSection('pendingTaskList', this)">
                <h2>Pending Tasks (@Model.Where(s => s.Status == "Pending").Count())</h2>
                <span class="arrow-icon">&#9662;</span> <!-- Mũi tên xuống mặc định -->
            </div>
            <div class="task-list" id="pendingTaskList" style="display: none;">
                @foreach (var subtask in Model.Where(s => s.Status == "Pending"))
                {
                    <div class="task-item" onclick="checkIfSubmit(event, '@subtask.SubtaskName', 'Assigned By','@subtask.AssignmentDate',
'@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
'@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description')">
                        <div class="task-info">
                            <span class="task-title">@subtask.SubtaskName</span>
                            <span class="task-status">(@subtask.Status)</span>
                        </div>
                        <div class="button-container">
                            <!-- Form để Accept Task -->
                                <form method="post" action="/Staff/UpdateStatus" onsubmit="return confirmUnsubmitTask()">
                                <input type="hidden" name="subtaskId" value="@subtask.SubtaskId" />
                                <input type="hidden" name="status" value="In Progress" />
                                <button type="submit" class="button">Unsubmit</button>
                            </form>
                            </div>
                    </div>
                   
                }
            </div>
        </div>

        <!-- View Task History Section -->
        <div class="task-container" id="completedTaskSection">
            <div class="task-header" onclick="toggleSection('completedTaskList', this)">
                <h2>View Task History (@Model.Where(s => s.Status == "Completed").Count())</h2>
                <span class="arrow-icon">&#9662;</span> <!-- Mũi tên xuống mặc định -->
            </div>
            <div class="task-list" id="completedTaskList" style="display: none;">
                @foreach (var subtask in Model.Where(s => s.Status == "Completed"))
                {
                    <div class="task-item" onclick="openModal('@subtask.SubtaskName', 'Assigned By','@subtask.AssignmentDate',
                    '@subtask.Deadline', '@(subtask.SubmissionDate.HasValue ? subtask.SubmissionDate : "Not yet")',
                    '@subtask.Priority', '@subtask.Difficulty', '@subtask.Status','@subtask.Description')">
                        <span class="task-title">@subtask.SubtaskName</span>
                        <span class="task-status">@subtask.Status</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Modal for Task Details -->
    <div class="modal" id="taskModal">
        <div class="modal-content">
            <button class="close-button" onclick="closeModal()">&times;</button>
            <h3 id="modalTitle">Task Details</h3>
            <p id="modalAssigner">Assigner: </p>
            <p id="modalAssignedDate">Assigned Date: </p>
            <p id="modalDueDate">Deadline: </p>
            <p id="modalSubmissionDate">Submission Date: </p> <!-- Thêm phần này để hiển thị Submission Date -->
            <p id="modalReward">Reward: </p>
            <p id="modalContent">Task description and details go here.</p>
        </div>
    </div>
  <script src="~/js/staff/task.js"></script>
</body>
</html>
