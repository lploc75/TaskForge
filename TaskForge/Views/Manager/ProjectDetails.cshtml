@model TaskForge.Models.Project

@{
    Layout = "_ManagerLayout";
}

<h1 class="page-title">Chi tiết dự án: @Model.ProjectName</h1>

<!-- Project description and details -->
<div class="project-details">
    <p><strong>Mô tả:</strong> @Model.Description</p>
    <p><strong>Trạng thái:</strong> @Model.Status</p>
    <p><strong>Hạn chót:</strong> @Model.Deadline?.ToString("yyyy-MM-dd")</p>
    <!-- Display related departments -->
    <p><strong>Phòng ban liên quan:</strong></p>
    <ul>
        @foreach (var department in Model.Departments)
        {
            <li>@department.DeptName</li>
        }
    </ul>
</div>

<!-- Error message alert -->
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @ViewBag.ErrorMessage
    </div>
}

<!-- Button to create new task -->
<button class="btn-create-task" onclick="openCreateTaskModal()">+ Tạo Task Mới</button>

<!-- Task list -->
<!-- Task list -->
<h2>Các Task thuộc dự án:</h2>
<table class="task-table">
    <thead>
        <tr>
            <th>Tên Task</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Ngày giao</th>
            <th>Hạn chót</th>
            <th>Ưu tiên</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in ViewBag.Tasks)
        {
            <tr>
                <td>@task.TaskName</td>
                <td>@task.Description</td>
                <td>@task.Status</td>
                <td>@task.AssignmentDate?.ToString("yyyy-MM-dd")</td>
                <td>@task.Deadline?.ToString("yyyy-MM-dd")</td>
                <td>
                    @{
                        string priorityLabel = task.Priority switch
                        {
                            1 => "1 - Thấp",
                            2 => "2 - Trung bình",
                            3 => "3 - Cao",
                            4 => "Rất cao",
                            _ => "Không xác định"
                        };
                    }
                    @priorityLabel
                </td>
                <td>
                    <button class="btn btn-edit"
                            onclick="openEditTaskModal('@task.TaskId', '@task.TaskName', '@task.Description', '@task.Priority', '@task.AssignmentDate?.ToString("yyyy-MM-dd")', '@task.Deadline?.ToString("yyyy-MM-dd")')">
                        Sửa
                    </button>
                    <button class="btn btn-delete" onclick="openDeleteTaskModal('@task.TaskId', '@task.TaskName')">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal chỉnh sửa task -->
<div id="editTaskModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close" onclick="closeEditTaskModal()">&times;</span>
        <h2>Chỉnh sửa Task</h2>
        <form asp-action="EditTask" method="post">
            <input type="hidden" id="edit-task-id" name="TaskId">

            <label for="edit-task-name">Tên Task</label>
            <input type="text" id="edit-task-name" name="TaskName" required>

            <label for="edit-description">Mô tả Task</label>
            <textarea id="edit-description" name="Description" rows="3"></textarea>

            <label for="edit-priority">Mức độ ưu tiên</label>
            <select id="edit-priority" name="Priority" required>
                <option value="1">1 - Thấp</option>
                <option value="2">2 - Trung bình</option>
                <option value="3">3 - Cao</option>
                <option value="4">4 - Rất cao</option>
            </select>

            <label for="edit-assignment-date">Ngày giao</label>
            <input type="date" id="edit-assignment-date" name="AssignmentDate" required>

            <label for="edit-deadline">Hạn chót</label>
            <input type="date" id="edit-deadline" name="Deadline" required>

            <button type="submit">Cập nhật Task</button>
        </form>
    </div>
</div>

<!-- Modal xóa task -->
<div id="deleteTaskModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close" onclick="closeDeleteTaskModal()">&times;</span>
        <h2>Xóa Task</h2>
        <p>Bạn có chắc chắn muốn xóa Task "<span id="delete-task-name"></span>"?</p>
        <form asp-action="DeleteTask" method="post">
            <input type="hidden" id="delete-task-id" name="TaskId">
            <button type="submit" class="btn btn-delete">Xóa</button>
            <button type="button" class="btn btn-cancel" onclick="closeDeleteTaskModal()">Hủy</button>
        </form>
    </div>
</div>

<!-- JavaScript for modals -->



<!-- Back to Project Management Page -->
<a class="back-link" href="@Url.Action("ProjectManage", "Manager")">Quay lại trang quản lý dự án</a>

<!-- Modal to create new task -->
<div id="createTaskModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeCreateTaskModal()">&times;</span>
        <h2>Tạo Task Mới</h2>
        <form asp-action="CreateTaskForProject" method="post">
            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />

            <label for="taskName">Tên Task</label>
            <input type="text" id="taskName" name="taskName" required />

            <label for="description">Mô tả Task</label>
            <textarea id="description" name="description" rows="3" required></textarea>

            <label for="priority">Mức độ ưu tiên</label>
            <select id="priority" name="priority" required>
                <option value="1">1 - Thấp</option>
                <option value="2">2 - Trung bình</option>
                <option value="3">3 - Cao</option>
                <option value="4">4 - Rất cao</option>
            </select>

            <label for="assignmentDate">Ngày giao</label>
            <input type="date" id="assignmentDate" name="assignmentDate" required />

            <label for="deadline">Hạn chót</label>
            <input type="date" id="deadline" name="deadline" required />

            <label for="departments">Chọn phòng ban</label>
            <select id="departments" name="departmentIds" multiple required>
                @foreach (var department in ViewBag.Departments)
                {
                    <option value="@department.DeptId">@department.DeptName</option>
                }
            </select>

            <button type="submit" class="btn-submit">Tạo Task</button>
        </form>

    </div>
</div>

<!-- JavaScript for modal -->
<script>
    function openCreateTaskModal() {
        document.getElementById('createTaskModal').style.display = 'flex';
    }

    function closeCreateTaskModal() {
        document.getElementById('createTaskModal').style.display = 'none';
    }

    // Mở modal chỉnh sửa task
    function openEditTaskModal(taskId, taskName, description, priority, assignmentDate, deadline) {
        document.getElementById('edit-task-id').value = taskId;
        document.getElementById('edit-task-name').value = taskName;
        document.getElementById('edit-description').value = description;
        document.getElementById('edit-priority').value = priority;
        document.getElementById('edit-assignment-date').value = assignmentDate;
        document.getElementById('edit-deadline').value = deadline;

        document.getElementById('editTaskModal').style.display = 'flex';
    }

    // Đóng modal chỉnh sửa task
    function closeEditTaskModal() {
        document.getElementById('editTaskModal').style.display = 'none';
    }

    // Mở modal xác nhận xóa task
    function openDeleteTaskModal(taskId, taskName) {
        document.getElementById('delete-task-id').value = taskId;
        document.getElementById('delete-task-name').innerText = taskName;
        document.getElementById('deleteTaskModal').style.display = 'flex';
    }

    // Đóng modal xác nhận xóa task
    function closeDeleteTaskModal() {
        document.getElementById('deleteTaskModal').style.display = 'none';
    }
</script>
<!-- CSS -->
<style>
    body {
        font-family: Arial, sans-serif;
    }

    .page-title {
        font-size: 24px;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    .project-details p {
        margin: 5px 0;
        font-size: 16px;
    }

    .alert {
        padding: 15px;
        margin-top: 20px;
        background-color: #f44336;
        color: white;
    }

    .btn-create-task {
        background-color: #28a745;
        color: white;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
        font-size: 16px;
        margin: 20px 0;
    }

    .task-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }

        .task-table th, .task-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        .task-table th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .task-table tr:hover {
            background-color: #f1f1f1;
        }

    .action-link {
        color: #007bff;
        text-decoration: none;
    }

        .action-link:hover {
            text-decoration: underline;
        }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #007bff;
        text-decoration: none;
    }

        .back-link:hover {
            text-decoration: underline;
        }

    /* Modal styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        width: 400px;
        position: relative;
    }

    .close {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 24px;
        cursor: pointer;
    }

    .modal input, .modal textarea, .modal select {
        width: 100%;
        margin-bottom: 10px;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .btn-submit {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
        width: 100%;
    }

        .btn-submit:hover {
            background-color: #218838;
        }
</style>
