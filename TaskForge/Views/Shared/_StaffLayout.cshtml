<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Staff Dashboard</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="~/css/staffLayout.css" />
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <ul>
            <li><a asp-controller="StaffAndLeader" asp-action="Index"><i class="material-icons">home</i> Dashboard</a></li>
            <li><a asp-controller="StaffAndLeader" asp-action="Task"><i class="material-icons">task</i> Task</a></li>
            <li><a asp-controller="StaffAndLeader" asp-action="Project"><i class="material-icons">dashboard</i> Project</a></li>
            <li><a asp-controller="StaffAndLeader" asp-action="Setting"><i class="material-icons">settings</i> Setting</a></li>
            <li><a asp-controller="StaffAndLeader" asp-action="Exchange"><i class="material-icons">shopping_cart</i> Exchange</a></li>
            <li><a asp-controller="StaffAndLeader" asp-action="Feedback"><i class="material-icons">feedback</i> Feedback</a></li>
            <li><a asp-controller="Account" asp-action="Login"><i class="material-icons">logout</i> Logout</a></li>
        </ul>
    </div>

    <!-- Navbar -->
    <div class="navbar">
        <div class="navbar-title">Staff Dashboard</div>

        <!-- Bell icon for notifications with dropdown -->
        <div class="icon-container">
            <i class="material-icons">notifications</i>
            <!-- Notification Dropdown -->
            <div id="notificationDropdown" class="notification-dropdown">
                <h3>Thông báo</h3>
                <ul class="notification-list">
                    @if (ViewData["RecentNotifications"] != null)
                    {
                        foreach (var notification in (List<TaskForge.Models.Notification>)ViewData["RecentNotifications"])
                        {
                            <li class="notification-item @(notification.IsRead == false ? "unread" : "")">
                                <div class="notification-content">
                                    <span>@notification.Message</span><br>
                                    <small>@notification.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </li>
                        }
                    }
                </ul>
                <div class="see-more">
                    <a href="@Url.Action("Index", "Notification")" class="btn btn-primary">Xem thêm thông báo</a>
                </div>
            </div>
        </div>

        <div class="avatar">
            <img src="https://via.placeholder.com/30" alt="Avatar">
        </div>
    </div>

    <!-- Main Content -->
    <div class="container" style="margin-left: 220px; padding-top: 60px;">
        @RenderBody()
    </div>

    <!-- JavaScript for Notifications -->
    <script>
        // Kiểm tra xem sự kiện click có hoạt động
        document.querySelector('.icon-container').addEventListener('click', function () {
            console.log("Bell icon clicked"); // Kiểm tra xem có log trong console không
            const dropdown = document.getElementById('notificationDropdown');

            if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                dropdown.style.display = 'block';
            } else {
                dropdown.style.display = 'none';
            }
        });

        // Đóng dropdown khi nhấp bên ngoài
        window.addEventListener('click', function (e) {
            if (!e.target.closest('.icon-container') && !e.target.closest('.notification-dropdown')) {
                document.getElementById('notificationDropdown').style.display = 'none';
            }
        });
    </script>

</body>
</html>
